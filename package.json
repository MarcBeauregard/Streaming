{
  "name": "feedswitch",
  "productName": "FeedSwitch",
  "version": "0.3.1",
  "private": true,
  "description": "Colle le lien d'une page de streaming, l'app trouve les flux vidéo et permet de passer de l'un à l'autre.",
  "author": "FeedSwitch",
  "type": "module",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "start": "electron .",
    "web": "node src/cli.js",
    "test": "node --test test/hls.test.js test/dash.test.js test/scan.test.js test/proxy.test.js",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "dashjs": "5.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "hls.js": "1.7.4"
  },
  "build": {
    "appId": "app.feedswitch.desktop",
    "productName": "FeedSwitch",
    "directories": {
      "buildResources": "desktop",
      "output": "dist"
    },
    "files": [
      "src/**",
      "public/**",
      "desktop/**"
    ],
    "asarUnpack": [
      "node_modules/playwright-core/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
